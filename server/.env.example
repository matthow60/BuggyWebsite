# Copy to server/.env (git-ignored) and fill in. Only the copy of the store that should record
# real crashes (your laptop during the demo) needs this file.
#
# Capture is ON only when CAPTURE_ENABLED=1 and MONGODB_URI are both set. It is forced OFF when
# the app is started by the AutomatedFix patcher (it sees TARGET_REPO / LLM_MODE / ... in the
# environment), so replays never create new incidents.

CAPTURE_ENABLED=1

# Same cluster, database and collection as AutomatedFix/.env (the patcher and the dashboard).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hackuta
MONGODB_COLLECTION=incidents

# Optional push notification. Not needed by AutomatedFix (it uses a MongoDB change stream).
WEBHOOK_URL=
WEBHOOK_SECRET=

# Optional overrides (normally read from git at startup):
# GIT_COMMIT=
# GIT_BRANCH=
# REPO_URL=

# Set to 1 to force capture off.
# CAPTURE_DISABLED=1
