# Copy to .env (server/.env or the repo-root .env; both are git-ignored) and fill in.
# Never commit real credentials.

# MongoDB Atlas connection string for crash reports (database hackuta, collection incidents).
# Leave empty to turn crash reporting off; the app still runs.
# Deliberately NOT named MONGODB_URI: the AutoFix engine passes its own MONGODB_URI to the
# replay copy of this app, and reporting from replays would loop forever.
# Reporting is also forced off whenever AUTOFIX_REPLAY is set.
CRASH_REPORT_MONGODB_URI=

PORT=3000

# Optional push notification after an incident is saved (the engine does not need it).
# WEBHOOK_URL=
# WEBHOOK_SECRET=
